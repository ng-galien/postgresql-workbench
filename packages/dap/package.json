{
  "name": "@ng-galien/postgresql-dap",
  "version": "0.1.0",
  "description": "Standalone PostgreSQL Debug Adapter Protocol server for PL/pgSQL",
  "license": "MIT",
  "author": {
    "name": "Alexandre Boyer",
    "url": "https://github.com/ng-galien"
  },
  "homepage": "https://ng-galien.github.io/postgresql-workbench/docs/dap.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/ng-galien/postgresql-workbench",
    "directory": "packages/dap"
  },
  "bugs": {
    "url": "https://github.com/ng-galien/postgresql-workbench/issues"
  },
  "type": "commonjs",
  "main": "./dist/postgresql-dap.js",
  "bin": {
    "postgresql-dap": "./dist/postgresql-dap.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "plpgsql",
    "debug-adapter-protocol",
    "dap",
    "debugger"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/dap/build-package.mjs && node ../../scripts/dap/verify-package.mjs"
  },
  "dependencies": {
    "@code-moniker/client": "0.10.1",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "pg": "^8.20.0"
  }
}
