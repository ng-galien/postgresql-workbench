{
  "name": "postgresql-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL development workbench for VS Code with SQL scratchpads, schema exploration, testing, coverage, and PL/pgSQL debugging",
  "homepage": "https://ng-galien.github.io/postgresql-workbench/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ng-galien/postgresql-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ng-galien/postgresql-workbench/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/dap/src/main.js",
  "scripts": {
    "build": "npm run build:dap && npm --prefix vscode-extension run compile && npm run build:ext",
    "build:dap": "node scripts/dap/clean.mjs && tsc",
    "build:dap:package": "node scripts/dap/build-package.mjs",
    "build:ext": "npm --prefix vscode-extension run build",
    "typecheck": "tsc --noEmit && tsc -p packages/views/tsconfig.json && tsc -p packages/shell/tsconfig.json && tsc -p e2e/tsconfig.json && npm --prefix vscode-extension run compile",
    "watch": "node scripts/dap/clean.mjs && tsc -w",
    "start": "node dist/dap/src/main.js",
    "check": "node scripts/issues/check-templates.mjs && biome check packages/ vscode-extension/src/ vscode-extension/tests/ e2e/ site/ scripts/",
    "check:fix": "node scripts/issues/check-templates.mjs && biome check --write packages/ vscode-extension/src/ vscode-extension/tests/ e2e/ site/ scripts/",
    "test": "vitest run packages vscode-extension scripts",
    "test:dap": "vitest run packages",
    "test:dap:package": "node scripts/dap/test-package.mjs",
    "test:e2e:up": "docker compose -f docker/e2e/compose.yml up -d --build --wait",
    "test:e2e:run": "npm run build:dap && vitest run e2e/ --exclude e2e/legacy-compat.test.ts --fileParallelism=false",
    "test:e2e:dap": "npm run build:dap && vitest run e2e/e2e.test.ts e2e/debug-lifecycle.test.ts e2e/syntax-consumers.test.ts --fileParallelism=false",
    "test:e2e:workbench": "REQUIRE_LOCAL_CODE_MONIKER=1 vitest run e2e/workbench-index.test.ts --fileParallelism=false",
    "test:e2e:lifecycle": "npm run build:dap && vitest run e2e/debug-lifecycle.test.ts --fileParallelism=false",
    "test:e2e:down": "docker compose -f docker/e2e/compose.yml down -v",
    "test:e2e": "node scripts/test/run-e2e.mjs",
    "test:e2e:legacy:up": "docker compose -f docker/legacy/compose.yml up -d --build --wait",
    "test:e2e:legacy:run": "npm run build:dap && vitest run e2e/legacy-compat.test.ts --fileParallelism=false",
    "test:e2e:legacy:down": "docker compose -f docker/legacy/compose.yml down -v",
    "test:e2e:legacy": "node scripts/test/run-e2e.mjs legacy",
    "bench:workbench-index": "node scripts/benchmark/workbench-index.mjs",
    "package:ext": "npm --prefix vscode-extension run package",
    "marketplace:media": "node scripts/marketplace/media.mjs",
    "site:build": "node scripts/site/build.mjs",
    "site:dev": "node scripts/site/dev.mjs",
    "shell": "node --watch-path=packages/shell/src packages/shell/server.mjs",
    "test:shell": "playwright test --config packages/shell/tests/playwright.config.ts"
  },
  "dependencies": {
    "@code-moniker/client": "0.7.1",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "^1.62.1",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/debugadapter-testsupport": "^1.68.0",
    "@xyflow/react": "^12.11.3",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.6",
    "jszip": "^3.10.1",
    "lefthook": "^2.1.4",
    "marked": "^18.0.9",
    "pg-cursor": "^2.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.8.0",
    "sql-formatter": "^15.8.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13"
  },
  "license": "MIT"
}
