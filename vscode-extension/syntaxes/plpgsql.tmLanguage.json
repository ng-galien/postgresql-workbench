{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PL/pgSQL",
  "scopeName": "source.plpgsql",
  "fileTypes": ["sql", "pgsql"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#dollar-quoted" },
    { "include": "#numbers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-dml" },
    { "include": "#keywords-ddl" },
    { "include": "#keywords-plpgsql" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.plpgsql",
          "match": "--.*$"
        },
        {
          "name": "comment.block.plpgsql",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.plpgsql",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.plpgsql", "match": "''" }
          ]
        },
        {
          "name": "string.quoted.other.plpgsql",
          "begin": "E'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.plpgsql", "match": "\\\\." }
          ]
        }
      ]
    },
    "dollar-quoted": {
      "name": "string.quoted.dollar.plpgsql",
      "begin": "\\$([a-zA-Z_]\\w*)?\\$",
      "end": "\\$([a-zA-Z_]\\w*)?\\$",
      "patterns": [
        { "include": "#keywords-plpgsql" },
        { "include": "#keywords-control" },
        { "include": "#keywords-dml" },
        { "include": "#types" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#function-call" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.plpgsql",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    "keywords-control": {
      "name": "keyword.control.plpgsql",
      "match": "(?i)\\b(BEGIN|END|IF|THEN|ELSIF|ELSE|LOOP|WHILE|FOR|FOREACH|EXIT|CONTINUE|RETURN|RAISE|EXCEPTION|WHEN|CASE|IN|REVERSE|SLICE|BY|PERFORM|EXECUTE|GET|DIAGNOSTICS|OPEN|FETCH|CLOSE|MOVE|DECLARE|ALIAS|CONSTANT|NOT|NULL|DEFAULT|FOUND|SQLSTATE|SQLERRM|ROW_COUNT|PG_EXCEPTION_DETAIL|PG_EXCEPTION_HINT)\\b"
    },
    "keywords-dml": {
      "name": "keyword.other.dml.plpgsql",
      "match": "(?i)\\b(SELECT|INSERT|UPDATE|DELETE|FROM|WHERE|JOIN|LEFT|RIGHT|INNER|OUTER|FULL|CROSS|ON|AS|INTO|VALUES|SET|RETURNING|WITH|UNION|INTERSECT|EXCEPT|ALL|DISTINCT|ORDER|GROUP|HAVING|LIMIT|OFFSET|CALL|USING|OVER|PARTITION|FILTER)\\b"
    },
    "keywords-ddl": {
      "name": "keyword.other.ddl.plpgsql",
      "match": "(?i)\\b(CREATE|OR|REPLACE|FUNCTION|PROCEDURE|RETURNS|LANGUAGE|SECURITY|DEFINER|INVOKER|STABLE|VOLATILE|IMMUTABLE|STRICT|CALLED|EXTERNAL|COST|ROWS|PARALLEL|SAFE|UNSAFE|RESTRICTED|TRIGGER|TABLE|VIEW|INDEX|SEQUENCE|SCHEMA|TYPE|DOMAIN|EXTENSION|AGGREGATE|OPERATOR|CAST|COMMENT|GRANT|REVOKE|TRUNCATE|DROP|ALTER|OWNED|BY)\\b"
    },
    "keywords-plpgsql": {
      "name": "keyword.other.plpgsql",
      "match": "(?i)\\b(IS|AND|OR|NOT|BETWEEN|LIKE|ILIKE|SIMILAR|TO|REGEXP|ANY|SOME|EXISTS|ARRAY|ROW|CAST|COALESCE|NULLIF|GREATEST|LEAST|EXTRACT|OVERLAY|POSITION|SUBSTRING|TRIM|LEADING|TRAILING|BOTH|COLLATE|AT|TIME|ZONE|WITHOUT|VARIADIC|OUT|INOUT|NOCALLED|WINDOW|RECURSIVE|LATERAL|TABLESAMPLE|REPEATABLE|NEXT|PRIOR|FIRST|LAST|ABSOLUTE|RELATIVE|FORWARD|BACKWARD|SCROLL|NO|HOLD|PLAN|RESET|SHOW|SET|GLOBAL|SESSION|LOCAL|TEMP|TEMPORARY|UNLOGGED|LOGGED)\\b"
    },
    "types": {
      "name": "support.type.plpgsql",
      "match": "(?i)\\b(int|integer|int2|int4|int8|bigint|smallint|numeric|decimal|real|float|float4|float8|double|precision|boolean|bool|text|varchar|character|char|varying|bytea|date|time|timestamp|timestamptz|interval|uuid|json|jsonb|xml|money|oid|void|record|setof|anyelement|anyarray|anynonarray|anyenum|anyrange|trigger|event_trigger|internal|language_handler|fdw_handler|index_am_handler|tsm_handler|pg_catalog|information_schema|serial|serial2|serial4|serial8|bigserial|smallserial|bit|varbit|cidr|inet|macaddr|macaddr8|point|line|lseg|box|path|polygon|circle|tsquery|tsvector|txid_snapshot|pg_lsn|regclass|regproc|regprocedure|regoper|regoperator|regtype|regnamespace|regrole)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.plpgsql",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.plpgsql",
          "match": "(=>|<>|!=|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.plpgsql",
          "match": "(\\+|-|\\*|/|%|\\^|\\|\\||::)"
        }
      ]
    },
    "function-call": {
      "name": "entity.name.function.plpgsql",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.plpgsql", "match": ";" },
        { "name": "punctuation.separator.comma.plpgsql", "match": "," },
        { "name": "punctuation.section.parens.begin.plpgsql", "match": "\\(" },
        { "name": "punctuation.section.parens.end.plpgsql", "match": "\\)" }
      ]
    }
  }
}
