{
  "name": "postgresql-workbench",
  "displayName": "PostgreSQL Workbench",
  "version": "1.1.0",
  "description": "Debug PL/pgSQL, run pgTAP tests with coverage, explore schemas, and query data in SQL scratchpads — without leaving VS Code.",
  "publisher": "ng-galien",
  "author": {
    "name": "Alexandre Boyer",
    "url": "https://github.com/ng-galien"
  },
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "preview": false,
  "markdown": "github",
  "repository": {
    "type": "git",
    "url": "https://github.com/ng-galien/postgresql-workbench"
  },
  "homepage": "https://ng-galien.github.io/postgresql-workbench/",
  "bugs": {
    "url": "https://github.com/ng-galien/postgresql-workbench/issues"
  },
  "vsce": {
    "baseImagesUrl": "https://raw.githubusercontent.com/ng-galien/postgresql-workbench/main/vscode-extension"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.1.0"
  },
  "icon": "icons/plpgsql-icon.png",
  "galleryBanner": {
    "color": "#336791",
    "theme": "dark"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "plpgsql",
    "pgtap",
    "debugger",
    "coverage",
    "sql",
    "database",
    "notebook"
  ],
  "engines": {
    "node": ">=22.0.0",
    "vscode": "^1.109.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Notebooks",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:code+moniker",
    "onFileSystem:postgresql-workbench",
    "onLanguage:sql",
    "onLanguage:plpgsql",
    "onNotebook:postgresql-workbench-sql",
    "onRenderer:postgresql-workbench.sql-result-renderer",
    "onDebugResolve:postgresql-workbench",
    "onView:postgresql-workbench-connections",
    "onView:postgresql-workbench-results"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "notebooks": [
      {
        "type": "postgresql-workbench-sql",
        "displayName": "PostgreSQL Workbench Notebook",
        "selector": [
          {
            "filenamePattern": "*.pgsql-notebook"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "postgresql-workbench.sql-result-renderer",
        "displayName": "PostgreSQL Workbench Results",
        "entrypoint": "./dist/sql-notebook-renderer.js",
        "requiresMessaging": "always",
        "mimeTypes": [
          "application/vnd.postgresql-workbench.sql-result+json"
        ]
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "code+moniker",
        "formatting": {
          "label": "${query.label}",
          "separator": "/",
          "workspaceSuffix": "PostgreSQL"
        }
      },
      {
        "scheme": "postgresql-workbench",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true,
          "workspaceSuffix": "PostgreSQL Workbench"
        }
      }
    ],
    "languages": [
      {
        "id": "plpgsql",
        "aliases": [
          "PostgreSQL",
          "PL/pgSQL",
          "plpgsql"
        ],
        "extensions": [
          ".pgsql",
          ".pgsql-notebook"
        ],
        "mimetypes": [
          "text/x-plpgsql"
        ],
        "filenamePatterns": [
          "code+moniker://**"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/plpgsql-light.svg",
          "dark": "./icons/plpgsql-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "plpgsql",
        "scopeName": "source.plpgsql",
        "path": "./syntaxes/plpgsql.tmLanguage.json"
      },
      {
        "scopeName": "source.plpgsql",
        "injectTo": [
          "source.sql"
        ],
        "path": "./syntaxes/plpgsql.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "variable": [
            "variable.other.plpgsql"
          ],
          "parameter": [
            "variable.parameter.plpgsql"
          ],
          "type": [
            "support.type.plpgsql"
          ],
          "function": [
            "entity.name.function.plpgsql"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "postgresql-workbench",
          "title": "PostgreSQL Workbench",
          "icon": "./icons/activity-bar.svg"
        }
      ],
      "panel": [
        {
          "id": "postgresql-workbench-results-container",
          "title": "PL/pgSQL Results",
          "icon": "./icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "postgresql-workbench": [
        {
          "id": "postgresql-workbench-connections",
          "name": "Workbench",
          "icon": "$(database)",
          "contextualTitle": "PostgreSQL Workbench"
        }
      ],
      "postgresql-workbench-results-container": [
        {
          "id": "postgresql-workbench-results",
          "name": "Results",
          "type": "webview",
          "icon": "$(table)",
          "contextualTitle": "PL/pgSQL Results"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "postgresql-workbench-connections",
        "contents": "[Start a local debug database with Docker](command:postgresql-workbench.startDockerDebugDatabase)\n[Add an existing server](command:postgresql-workbench.addServer)"
      }
    ],
    "submenus": [
      {
        "id": "postgresql-workbench.scratchpadExecutionMode",
        "label": "Mode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "postgresql-workbench.removeServer",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.editServer",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.changePassword",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.connectServer",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.useDatabaseContextAsActive",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.disconnectServer",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.manageDebugSessions",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.debugFromTree",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.openFunction",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.openDatabaseObject",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.revealDatabaseObjectInTree",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.showObjectActions",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.debugDefinition",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.debugCall",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.revealRoutineTests",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.renameSqlNotebook",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.deleteSqlNotebook",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.duplicateSqlNotebook",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.exportSqlNotebook",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.refreshSqlNotebooks",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.setScratchpadAutoMode",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.setScratchpadManualMode",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.commitScratchpadTransaction",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.rollbackScratchpadTransaction",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.cancelDatabaseIndex",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.provisionWorkbenchSchemaSync",
          "when": "false"
        },
        {
          "command": "postgresql-workbench.removeWorkbenchSchemaSyncProvisioning",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "postgresql-workbench.pickConnection",
          "when": "view == postgresql-workbench-connections",
          "group": "navigation"
        },
        {
          "command": "postgresql-workbench.openDatabaseGraph",
          "when": "view == postgresql-workbench-connections",
          "group": "navigation@1"
        },
        {
          "command": "postgresql-workbench.indexActiveDatabase",
          "when": "view == postgresql-workbench-connections",
          "group": "navigation@3"
        },
        {
          "command": "postgresql-workbench.searchDatabaseObjects",
          "when": "view == postgresql-workbench-connections",
          "group": "navigation@2"
        },
        {
          "command": "postgresql-workbench.newSqlNotebook",
          "when": "view == postgresql-workbench-connections",
          "group": "navigation@4"
        },
        {
          "command": "postgresql-workbench.results.copy",
          "when": "view == postgresql-workbench-results",
          "group": "navigation@1"
        },
        {
          "command": "postgresql-workbench.results.export",
          "when": "view == postgresql-workbench-results",
          "group": "navigation@2"
        },
        {
          "command": "postgresql-workbench.results.clear",
          "when": "view == postgresql-workbench-results",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "postgresql-workbench.removeServer",
          "when": "viewItem == postgresql-workbench-server || viewItem == postgresql-workbench-server-connected",
          "group": "9_server"
        },
        {
          "command": "postgresql-workbench.editServer",
          "when": "viewItem == postgresql-workbench-server || viewItem == postgresql-workbench-server-connected",
          "group": "9_server"
        },
        {
          "command": "postgresql-workbench.changePassword",
          "when": "viewItem == postgresql-workbench-server || viewItem == postgresql-workbench-server-connected",
          "group": "9_server"
        },
        {
          "command": "postgresql-workbench.disconnectServer",
          "when": "viewItem == postgresql-workbench-server-connected",
          "group": "9_server"
        },
        {
          "command": "postgresql-workbench.manageDebugSessions",
          "when": "viewItem == postgresql-workbench-server-connected",
          "group": "navigation"
        },
        {
          "command": "postgresql-workbench.connectServer",
          "when": "viewItem == postgresql-workbench-server",
          "group": "inline"
        },
        {
          "command": "postgresql-workbench.useDatabaseContextAsActive",
          "when": "viewItem == postgresql-workbench-database-context",
          "group": "inline"
        },
        {
          "command": "postgresql-workbench.configureWorkbenchSchemaSync",
          "when": "viewItem =~ /postgresql-workbench-schema-sync-/",
          "group": "navigation"
        },
        {
          "command": "postgresql-workbench.indexActiveDatabase",
          "when": "view == postgresql-workbench-connections && viewItem == postgresql-workbench-sources-active",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.cancelDatabaseIndex",
          "when": "view == postgresql-workbench-connections && viewItem == postgresql-workbench-sources-indexing",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.provisionWorkbenchSchemaSync",
          "when": "viewItem == postgresql-workbench-schema-sync-provisioning-required || viewItem == postgresql-workbench-schema-sync-insufficient-privilege",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.removeWorkbenchSchemaSyncProvisioning",
          "when": "viewItem == postgresql-workbench-schema-sync-listening || viewItem == postgresql-workbench-schema-sync-desynchronized",
          "group": "navigation@9"
        },
        {
          "command": "postgresql-workbench.newSqlNotebook",
          "when": "viewItem == postgresql-workbench-scratchpads",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.openFunction",
          "when": "viewItem == postgresql-workbench-function || viewItem == postgresql-workbench-function-debuggable",
          "group": "navigation"
        },
        {
          "command": "postgresql-workbench.revealRoutineTests",
          "when": "viewItem == postgresql-workbench-function || viewItem == postgresql-workbench-function-debuggable",
          "group": "navigation@2"
        },
        {
          "command": "postgresql-workbench.debugFromTree",
          "when": "viewItem == postgresql-workbench-function-debuggable",
          "group": "inline"
        },
        {
          "command": "postgresql-workbench.showObjectActions",
          "when": "viewItem == postgresql-workbench-function || viewItem == postgresql-workbench-function-debuggable || viewItem == postgresql-workbench-table || viewItem == postgresql-workbench-view || viewItem == postgresql-workbench-procedure || viewItem == postgresql-workbench-trigger",
          "group": "navigation@4"
        },
        {
          "command": "postgresql-workbench.revealDatabaseObjectInTree",
          "when": "view == postgresql-workbench-connections && viewItem == postgresql-workbench-relation-target",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.openDatabaseObject",
          "when": "view == postgresql-workbench-connections && (viewItem == postgresql-workbench-function || viewItem == postgresql-workbench-function-debuggable || viewItem == postgresql-workbench-table || viewItem == postgresql-workbench-view || viewItem == postgresql-workbench-procedure || viewItem == postgresql-workbench-trigger || viewItem == postgresql-workbench-relation-target)",
          "group": "inline@2"
        },
        {
          "command": "postgresql-workbench.openSqlNotebook",
          "when": "view == postgresql-workbench-connections && (viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual)",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.changeSqlNotebookConnection",
          "when": "viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual",
          "group": "navigation@1"
        },
        {
          "command": "postgresql-workbench.setScratchpadManualMode",
          "when": "viewItem == postgresql-workbench-scratchpad-auto",
          "group": "inline@2"
        },
        {
          "command": "postgresql-workbench.setScratchpadAutoMode",
          "when": "viewItem == postgresql-workbench-scratchpad-manual",
          "group": "inline@2"
        },
        {
          "submenu": "postgresql-workbench.scratchpadExecutionMode",
          "when": "viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual",
          "group": "navigation@2"
        },
        {
          "command": "postgresql-workbench.renameSqlNotebook",
          "when": "view == postgresql-workbench-connections && (viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual)",
          "group": "navigation@3"
        },
        {
          "command": "postgresql-workbench.duplicateSqlNotebook",
          "when": "view == postgresql-workbench-connections && (viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual)",
          "group": "navigation@4"
        },
        {
          "command": "postgresql-workbench.exportSqlNotebook",
          "when": "view == postgresql-workbench-connections && (viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual)",
          "group": "navigation@5"
        },
        {
          "command": "postgresql-workbench.deleteSqlNotebook",
          "when": "view == postgresql-workbench-connections && (viewItem == postgresql-workbench-scratchpad-auto || viewItem == postgresql-workbench-scratchpad-manual)",
          "group": "navigation@6"
        },
        {
          "command": "postgresql-workbench.changeSqlNotebookConnection",
          "when": "viewItem =~ /postgresql-workbench-scratchpad-association-/",
          "group": "navigation@1"
        },
        {
          "command": "postgresql-workbench.reconnectSqlNotebook",
          "when": "viewItem == postgresql-workbench-scratchpad-association-associated",
          "group": "navigation@2"
        },
        {
          "command": "postgresql-workbench.useSqlNotebookBindingAsActive",
          "when": "viewItem == postgresql-workbench-scratchpad-association-associated",
          "group": "navigation@3"
        },
        {
          "command": "postgresql-workbench.commitScratchpadTransaction",
          "when": "viewItem == postgresql-workbench-scratchpad-transaction-in-progress",
          "group": "inline@1"
        },
        {
          "command": "postgresql-workbench.rollbackScratchpadTransaction",
          "when": "viewItem == postgresql-workbench-scratchpad-transaction-in-progress || viewItem == postgresql-workbench-scratchpad-transaction-failed",
          "group": "inline@2"
        }
      ],
      "postgresql-workbench.scratchpadExecutionMode": [
        {
          "command": "postgresql-workbench.setScratchpadAutoMode"
        },
        {
          "command": "postgresql-workbench.setScratchpadManualMode"
        }
      ],
      "editor/title": [
        {
          "command": "postgresql-workbench.revealRoutineTests",
          "when": "resourceScheme == code+moniker",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "postgresql-workbench.executeSqlSelection",
          "when": "editorHasSelection && (editorLangId == sql || editorLangId == plpgsql)",
          "group": "navigation@1"
        }
      ]
    },
    "commands": [
      {
        "command": "postgresql-workbench.addServer",
        "title": "PostgreSQL Workbench: Add Server",
        "icon": "$(add)"
      },
      {
        "command": "postgresql-workbench.useDatabaseContextAsActive",
        "title": "PostgreSQL Workbench: Set Database Context Active",
        "icon": "$(target)"
      },
      {
        "command": "postgresql-workbench.startDockerDebugDatabase",
        "title": "PL/pgSQL: Start Local Debug Database (Docker)",
        "icon": "$(vm-running)"
      },
      {
        "command": "postgresql-workbench.removeServer",
        "title": "Remove Server",
        "icon": "$(trash)"
      },
      {
        "command": "postgresql-workbench.connectServer",
        "title": "Connect",
        "icon": "$(plug)"
      },
      {
        "command": "postgresql-workbench.disconnectServer",
        "title": "Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "postgresql-workbench.editServer",
        "title": "Edit Server",
        "icon": "$(edit)"
      },
      {
        "command": "postgresql-workbench.changePassword",
        "title": "Change Password",
        "icon": "$(key)"
      },
      {
        "command": "postgresql-workbench.pickConnection",
        "title": "PL/pgSQL: Pick Connection",
        "icon": "$(plug)"
      },
      {
        "command": "postgresql-workbench.refreshTree",
        "title": "PL/pgSQL: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "postgresql-workbench.indexActiveDatabase",
        "title": "PL/pgSQL Workbench: Reindex Active Database",
        "icon": "$(refresh)"
      },
      {
        "command": "postgresql-workbench.cancelDatabaseIndex",
        "title": "PostgreSQL Workbench: Cancel Database Indexing",
        "icon": "$(debug-stop)"
      },
      {
        "command": "postgresql-workbench.configureWorkbenchSchemaSync",
        "title": "PostgreSQL Workbench: Configure Schema Synchronization",
        "icon": "$(radio-tower)"
      },
      {
        "command": "postgresql-workbench.provisionWorkbenchSchemaSync",
        "title": "PostgreSQL Workbench: Provision Schema Synchronization",
        "icon": "$(tools)"
      },
      {
        "command": "postgresql-workbench.removeWorkbenchSchemaSyncProvisioning",
        "title": "PostgreSQL Workbench: Remove Schema Synchronization Provisioning",
        "icon": "$(trash)"
      },
      {
        "command": "postgresql-workbench.searchDatabaseObjects",
        "title": "PostgreSQL Workbench: Search Database Objects",
        "icon": "$(search)"
      },
      {
        "command": "postgresql-workbench.openDatabaseObject",
        "title": "Open PostgreSQL Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "postgresql-workbench.revealDatabaseObjectInTree",
        "title": "Reveal PostgreSQL Object in Workbench Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "postgresql-workbench.openDatabaseGraph",
        "title": "Open PostgreSQL Cockpit",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "postgresql-workbench.showObjectActions",
        "title": "PostgreSQL Object Actions...",
        "icon": "$(gear)"
      },
      {
        "command": "postgresql-workbench.executeSqlSelection",
        "title": "PostgreSQL Workbench: Execute SQL Selection",
        "icon": "$(play)"
      },
      {
        "command": "postgresql-workbench.newSqlNotebook",
        "title": "PostgreSQL Workbench: New SQL Scratchpad",
        "icon": "$(notebook-template)"
      },
      {
        "command": "postgresql-workbench.openSqlNotebook",
        "title": "Open SQL Scratchpad",
        "icon": "$(notebook)"
      },
      {
        "command": "postgresql-workbench.renameSqlNotebook",
        "title": "Rename SQL Scratchpad",
        "icon": "$(edit)"
      },
      {
        "command": "postgresql-workbench.deleteSqlNotebook",
        "title": "Delete SQL Scratchpad",
        "icon": "$(trash)"
      },
      {
        "command": "postgresql-workbench.duplicateSqlNotebook",
        "title": "Duplicate SQL Scratchpad",
        "icon": "$(copy)"
      },
      {
        "command": "postgresql-workbench.exportSqlNotebook",
        "title": "Export SQL Scratchpad...",
        "icon": "$(export)"
      },
      {
        "command": "postgresql-workbench.refreshSqlNotebooks",
        "title": "Refresh SQL Scratchpads",
        "icon": "$(refresh)"
      },
      {
        "command": "postgresql-workbench.changeSqlNotebookConnection",
        "title": "Scratchpad Association...",
        "icon": "$(database)"
      },
      {
        "command": "postgresql-workbench.reconnectSqlNotebook",
        "title": "PostgreSQL Workbench: Reconnect Scratchpad Association",
        "icon": "$(debug-restart)"
      },
      {
        "command": "postgresql-workbench.useSqlNotebookBindingAsActive",
        "title": "PostgreSQL Workbench: Use Association as Active",
        "icon": "$(target)"
      },
      {
        "command": "postgresql-workbench.setScratchpadAutoMode",
        "title": "Mode AUTO",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "postgresql-workbench.setScratchpadManualMode",
        "title": "Mode MANUAL",
        "icon": "$(debug-pause)"
      },
      {
        "command": "postgresql-workbench.commitScratchpadTransaction",
        "title": "Commit",
        "icon": "$(check)"
      },
      {
        "command": "postgresql-workbench.rollbackScratchpadTransaction",
        "title": "Rollback",
        "icon": "$(discard)"
      },
      {
        "command": "postgresql-workbench.compareRoutineWithDatabase",
        "title": "PostgreSQL Workbench: Compare Routine with Database",
