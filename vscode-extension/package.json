    "configuration": {
      "title": "PostgreSQL Workbench",
      "properties": {
        "postgresql-workbench.workbench.schemaSync.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Opt in to automatic PostgreSQL schema synchronization for DatabaseContexts without an explicit connection override. Provisioning remains a separate confirmed action. Data changes (DML) never trigger synchronization."
        },
        "postgresql-workbench.workbench.schemaSync.supportSchema": {
          "type": "string",
          "default": "workbench",
          "pattern": "^(?!pg_)[a-z_][a-z0-9_]{0,62}$",
          "patternErrorMessage": "Use a lower-case, unquoted PostgreSQL identifier of at most 63 characters; pg_ prefixes are reserved.",
          "scope": "window",
          "description": "PostgreSQL schema containing the Workbench DDL notification functions. Event triggers remain database-level objects and are not contained by this schema."
        },
        "postgresql-workbench.workbench.codeMoniker.commandTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "window",
          "description": "Maximum duration in milliseconds for one Code Moniker daemon command used by Workbench indexing, navigation, graph queries, and debugger syntax analysis. Changes apply to the next extension session."
        },
        "postgresql-workbench.workbench.graph.compactZoomThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0.25,
          "maximum": 1,
          "scope": "window",
          "description": "Zoom level below which PostgreSQL graph nodes switch from detailed cards to compact named cards. Changes apply immediately to an open graph."
        },
        "postgresql-workbench.workbench.graph.compactNodeFontScale": {
          "type": "number",
          "default": 1.6,
          "minimum": 0.8,
          "maximum": 2,
          "scope": "window",
          "description": "Font scale used for object names in compact PostgreSQL graph nodes. Changes apply immediately to an open graph."
        },
        "postgresql-workbench.workbench.graph.edgeLabelFontScale": {
          "type": "number",
          "default": 1.3,
          "minimum": 0.8,
          "maximum": 2,
          "scope": "window",
          "description": "Font scale applied to PostgreSQL graph edge labels. Changes apply immediately to an open graph."
        },
        "postgresql-workbench.results.maxRows": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 1000,
          "scope": "window",
          "description": "Maximum number of PostgreSQL rows retained for SQL selections and debug results. It is also used as the notebook page size when results.pageSize has not been configured explicitly."
        },
        "postgresql-workbench.results.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 1000,
          "scope": "window",
          "description": "Number of rows loaded initially and by each Next action for cursor-backed Scratchpad results."
        },
        "postgresql-workbench.results.maxCachedRows": {
          "type": "number",
          "default": 1000,
          "minimum": 20,
          "maximum": 100000,
          "scope": "window",
          "description": "Maximum number of cursor-backed notebook rows retained for Previous navigation. Load all explicitly bypasses this limit."
        },
        "postgresql-workbench.results.cursorIdleTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "maximum": 3600,
          "scope": "window",
          "description": "Close an idle PostgreSQL Scratchpad result cursor after this many seconds."
        },
        "postgresql-workbench.results.nonPagedMaxRows": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 1000,
          "scope": "window",
          "description": "Maximum rows retained for notebook statements that cannot be paged safely, including data-modifying statements with RETURNING."
        },
        "postgresql-workbench.results.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reveal the PL/pgSQL Results panel without taking keyboard focus when a debugged SQL call completes or fails."
        },
        "postgresql-workbench.tests.patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "*_ut.test_*",
            "*_it.test_*"
          ],
          "scope": "window",
          "description": "Glob patterns used to discover pgTAP test functions, matched against schema.function. Matching functions must return SETOF text; zero-argument functions can be run automatically. Schemas containing matched tests are treated as test infrastructure for coverage mapping."
        },
        "postgresql-workbench.coverage.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for routines eligible for coverage, matched against schema.name(identity arguments). An empty list includes all discovered routines."
        },
        "postgresql-workbench.coverage.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for routines excluded from coverage, matched after the include patterns."
        },
        "postgresql-workbench.coverage.maxRoutines": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 2000,
          "description": "Maximum number of PL/pgSQL routines instrumented by one coverage request."
        },
        "postgresql-workbench.coverage.maxOutputLines": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 5000,
          "description": "Maximum number of TAP output lines attached to each VS Code test result."
        },
        "postgresql-workbench.coverage.maxOutputBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 16384,
          "maximum": 16777216,
          "description": "Maximum TAP payload retained for one pgTAP test. Individual rows are truncated in PostgreSQL before transmission."
        },
        "postgresql-workbench.coverage.maxParallelDatabases": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum number of independent PostgreSQL databases covered in parallel."
        },
        "postgresql-workbench.coverage.timeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "maximum": 3600000,
          "description": "Maximum duration in milliseconds for one database coverage suite, including rollback and cleanup."
        }
      }
    },
    "breakpoints": [
      {
        "language": "plpgsql"
      },
      {
        "language": "sql"
      }
    ],
    "debuggers": [
      {
        "type": "postgresql-workbench",
        "label": "PL/pgSQL Debug",
        "program": "./dist/dap-server.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "server": {
                "type": "string",
                "description": "Server ID from PL/pgSQL connection manager (e.g. 'localhost:5432/mydb:postgres'). If omitted, uses the active server."
              },
              "sql": {
                "type": "string",
                "description": "SQL statement to debug (CALL or SELECT). Optional when 'routine' is provided."
              },
              "routine": {
                "type": "object",
                "description": "Structured routine target used by the extension to launch debug sessions without interpolating SQL arguments.",
                "properties": {
                  "schema": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "function",
                      "procedure"
                    ]
                  },
                  "oid": {
                    "type": "number"
                  },
                  "argTypes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "routineArgs": {
                "type": "array",
                "description": "Structured argument values bound by the debug adapter.",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line of the function (default: true)",
                "default": true
              },
              "resultMaxRows": {
                "type": "number",
                "minimum": 20,
                "maximum": 1000,
                "description": "Maximum number of target SQL result rows retained for display.",
                "default": 200
              },
              "ssl": {
                "type": [
                  "boolean",
                  "string"
                ],
                "enum": [
                  true,
                  false,
                  "require",
                  "prefer",
                  "disable"
                ],
                "description": "SSL mode: true/'require', 'prefer', or false/'disable'",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "postgresql-workbench",
            "request": "launch",
            "name": "Debug PL/pgSQL",
            "sql": "SELECT my_function()"
          }
        ],
        "configurationSnippets": [
          {
            "label": "PL/pgSQL: Debug Function",
            "description": "Debug a PL/pgSQL function or procedure",
            "body": {
              "type": "postgresql-workbench",
              "request": "launch",
              "name": "Debug ${1:function_name}",
              "sql": "${2:SELECT my_function()}"
            }
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "postgresql-workbench.gettingStarted",
        "title": "Getting Started with PostgreSQL Workbench",
        "description": "Set up PostgreSQL debugging and pgTAP coverage in 6 steps.",
        "steps": [
          {
            "id": "addServer",
            "title": "Start or Add a PostgreSQL Server",
            "description": "For the fastest setup, let the extension pull a ready-to-debug PostgreSQL image, start it locally, and connect it automatically.\n\n[Start with Docker](command:postgresql-workbench.startDockerDebugDatabase)\n\nAlready have a server? [Add Server](command:postgresql-workbench.addServer)",
            "completionEvents": [
              "onCommand:postgresql-workbench.startDockerDebugDatabase",
              "onCommand:postgresql-workbench.addServer"
            ]
          },
          {
            "id": "verifyConnection",
            "title": "Verify Connection & pldbgapi",
            "description": "Once connected, the status bar shows the server name and the sidebar shows your functions. If pldbgapi is missing, the extension offers to install it.\n\nPrerequisites:\n```\n# postgresql.conf\nshared_preload_libraries = 'plugin_debugger'\n```\n```sql\nCREATE EXTENSION pldbgapi;\n```",
            "completionEvents": [
              "onContext:postgresql-workbench.connected"
            ]
          },
          {
            "id": "browseFunctions",
            "title": "Browse Functions",
            "description": "Open the PostgreSQL Workbench to browse the active database sources and its scratchpads in one tree.\n\n[Open Workbench](command:postgresql-workbench-connections.focus)",
            "completionEvents": [
              "onView:postgresql-workbench-connections"
            ]
          },
          {
            "id": "setBreakpoint",
            "title": "Set a Breakpoint",
            "description": "Click in the gutter next to a PL/pgSQL line to set a breakpoint. Only executable lines (assignments, IF, LOOP, RETURN, etc.) can have breakpoints — non-steppable lines are rejected automatically."
          },
          {
            "id": "launchDebug",
            "title": "Launch a Debug Session",
            "description": "Three ways to start debugging:\n- **CodeLens**: Click \"Debug\" above a `CREATE FUNCTION`, `CALL`, or `SELECT` statement\n- **Sidebar**: Right-click a function → Debug\n- **launch.json**: Add a `plpgsql` configuration\n\n[Open a SQL File](command:workbench.action.files.openFile)",
            "completionEvents": [
              "onCommand:postgresql-workbench.debugCall",
              "onCommand:postgresql-workbench.debugDefinition",
              "onCommand:postgresql-workbench.debugFromTree"
            ]
          },
          {
            "id": "runCoverage",
            "title": "Run pgTAP Tests with Coverage",
            "description": "Install `pgtap` in your development database and define zero-argument `SETOF text` test functions. The default discovery patterns are `*_ut.test_*` and `*_it.test_*`, configurable globally or per workspace.\n\nCoverage is transactional and independent from pldebugger.\n\n[Open Testing](command:workbench.view.testing.focus)",
            "completionEvents": [
              "onCommand:testing.coverageAll"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "stage:code-moniker": "node scripts/stage-code-moniker-runtime.mjs",
    "build": "npm run stage:code-moniker && node esbuild.mjs",
    "build:production": "npm run stage:code-moniker && node esbuild.mjs --production",
    "watch": "npm run stage:code-moniker && node esbuild.mjs --watch",
    "compile": "tsc --noEmit",
    "test:scripts": "node --test scripts/*.node-test.mjs",
    "pretest": "npm run build && tsc -p . --outDir dist && node scripts/mark-test-output-esm.mjs && node scripts/build-vscode-smoke.mjs",
    "test": "vscode-test --fail-zero",
    "test:smoke": "npm run pretest && node scripts/run-vscode-test.mjs --timeout-ms 90000 -- --config .vscode-smoke.mjs --fail-zero",
    "test:min-vscode": "npm run pretest && node scripts/run-vscode-test.mjs --timeout-ms 90000 -- --config .vscode-smoke.mjs --code-version 1.109.0 --fail-zero",
    "test:acceptance:typecheck": "tsc -p acceptance/tsconfig.json",
    "test:acceptance": "npm run build:production && npm run test:acceptance:typecheck && playwright test --config playwright.acceptance.config.ts",
    "test:bootstrap": "npm run build:production && npm run test:acceptance:typecheck && playwright test --config playwright.bootstrap.config.ts",
    "test:acceptance:graph-dnd": "npm run build:production && npm run test:acceptance:typecheck && playwright test --config playwright.acceptance.config.ts acceptance/specs/acceptance.spec.ts --grep 'Workbench graph'",
    "test:acceptance:debugger": "npm run build:production && npm run test:acceptance:typecheck && playwright test --config playwright.acceptance.config.ts acceptance/specs/acceptance.spec.ts --grep 'PL/pgSQL debugger'",
    "test:acceptance:source-tab-cleanup": "npm run build:production && npm run test:acceptance:typecheck && playwright test --config playwright.acceptance.config.ts acceptance/specs/acceptance.spec.ts --grep 'virtual source cleanup'",
    "package": "npm run build:production && node scripts/package-local.mjs && npm run verify:package",
    "verify:package": "node scripts/verify-code-moniker-vsix.mjs",
    "checksum:package": "node scripts/checksum-file.mjs",
    "publish": "node scripts/refuse-direct-publish.mjs",
    "vscode:prepublish": "npm run build:production"
  },
  "dependencies": {
    "@code-moniker/client": "^0.6.1",
    "@shikijs/core": "^4.4.1",
    "@shikijs/engine-javascript": "^4.4.1",
    "@shikijs/langs": "^4.4.1",
    "@shikijs/themes": "^4.4.1",
    "@xyflow/react": "^12.11.2",
    "pg": "^8.20.0",
    "pg-cursor": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/mocha": "^10.0.10",
    "@types/pg": "^8.18.0",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "1.109.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "jszip": "^3.10.1",
    "mocha": "^11.7.5",
    "typescript": "^5.7.0"
  }
}
