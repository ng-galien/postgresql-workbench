{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "!**/dist",
      "!packages/sql/src/authoring/generated",
      "vscode-extension/src/**",
      "vscode-extension/tests/**",
      "e2e/**",
      "scripts/**",
      "site/**",
      "!!**/dist/",
      "!!**/node_modules/"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "warn"
      }
    }
  }
}
