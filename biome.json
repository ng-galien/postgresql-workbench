{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "src/**",
      "vscode-extension/src/**",
      "vscode-extension/acceptance/**",
      "vscode-extension/playwright.acceptance.config.ts",
      "e2e/**",
      "site/**",
      "scripts/build-site.mjs",
      "scripts/dev-site.mjs",
      "scripts/create-issue.mjs",
      "scripts/check-issue-templates.mjs",
      "scripts/issue-workflow.mjs",
      "scripts/workbench-index-benchmark.mjs",
      "scripts/workbench-index-benchmark.node-test.mjs",
      "!!**/dist/",
      "!!**/node_modules/"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "warn"
      }
    }
  }
}
